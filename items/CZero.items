// Filename: CZero.items
// Citroën C-Zero via MeatPi WiCAN (OBD, passive: CAN broadcasts 0x374/0x373/0x346/0x412 over the WiCAN MQTT filter, no polling)
// — things: things/MQTT_WiCAN.things
// Charging control stays with ergant (items/ergant.items, gErgantCar); this file is only the car's own data.
//
// Structure:
//   Tier 1 — semantic car equipment under Garage: SOC + age, battery voltage/current/power, range, odometer,
//            plugged-in status
//   Tier 2 — non-semantic gCZeroDiag: WiCAN connection
//
// All values keep their last value while the car is off (WiCAN asleep) — check CZero_Soc_Updated before using
// them; CZero_Battery_Power goes UNDEF when the WiCAN goes offline (rules/czero.rules).
// SOC, voltage, current every 10 s while READY or charging (SOC 0.5 % steps), range 30 s, odometer 60 s.
// Persistence: default * lines (everyChange, restoreOnStartup) — not in gEnergySystem on purpose.
// CZero_Plugged*: computed by rule H in rules/ergant_car.rules from socket power, socket state, ergant state
// and SOC (no sensor sees the cable) — yes / probably / no / unknown, published to ergant/input/car/plugged.

// ---------------------------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------------------------
Group                   gCZero                          "Citroën C-Zero"                    <if:mdi:car-electric>           (gGarage)           ["Car"]
Group                   gCZeroDiag                      "C-Zero WiCAN Diagnose"             <if:mdi:lan-connect>


// ---------------------------------------------------------------------------------------------
// Tier 1 — car
// ---------------------------------------------------------------------------------------------
Number:Dimensionless    CZero_Soc                       "Ladestand [%.1f %%]"          <if:mdi:battery-medium>         (gCZero)            ["Measurement","Level"]     {unit="%", channel="mqtt:topic:wican_czero:soc"}
Number:Dimensionless    CZero_Soc_Display               "Ladestand Anzeige [%.1f %%]"       <if:mdi:gauge>                  (gCZero)            ["Measurement","Level"]     {unit="%", channel="mqtt:topic:wican_czero:soc_display"}
DateTime                CZero_Soc_Updated               "Ladestand gemessen [%1$td.%1$tm. %1$tH:%1$tM]"  <if:mdi:clock-outline>  (gCZero)  ["Status","Timestamp"]  {channel="mqtt:topic:wican_czero:soc"[profile="timestamp-update"]}
Number:ElectricPotential CZero_Battery_Voltage          "Batteriespannung [%.1f V]"         <if:mdi:flash-triangle-outline> (gCZero)            ["Measurement","Voltage"]   {unit="V", channel="mqtt:topic:wican_czero:battery_voltage"}
// Negative = discharge (driving), positive = charging
Number:ElectricCurrent  CZero_Battery_Current           "Batteriestrom [%.1f A]"            <if:mdi:current-dc>             (gCZero)            ["Measurement","Current"]   {unit="A", channel="mqtt:topic:wican_czero:battery_current"}
// Voltage × current, positive = charging (rules/czero.rules)
Number:Power            CZero_Battery_Power             "Batterieleistung [%.0f W]"         <if:mdi:battery-charging>       (gCZero)            ["Measurement","Power"]     {unit="W"}
Number:Length           CZero_Range                     "Reichweite [%.0f km]"              <if:mdi:map-marker-distance>    (gCZero)            ["Measurement"]             {unit="km", channel="mqtt:topic:wican_czero:range"}
Number:Length           CZero_Odometer                  "Kilometerstand [%.0f km]"          <if:mdi:counter>                (gCZero)            ["Measurement"]             {unit="km", channel="mqtt:topic:wican_czero:odometer"}
String                  CZero_Plugged                   "Angesteckt [%s]"                   <if:mdi:power-plug>             (gCZero)            ["Status"]                  {stateDescription=""[options="yes=Ja (lädt),probably=Wahrscheinlich (Ladepause),no=Nein,unknown=Unbekannt"]}
DateTime                CZero_Plugged_Since             "Angesteckt-Status seit [%1$td.%1$tm. %1$tH:%1$tM]"  <if:mdi:clock-outline>  (gCZero)  ["Status","Timestamp"]
DateTime                CZero_Plugged_LastDraw          "Zuletzt Strom gezogen [%1$td.%1$tm. %1$tH:%1$tM]"  <if:mdi:clock-outline>  (gCZero)  ["Status","Timestamp"]


// ---------------------------------------------------------------------------------------------
// Tier 2 — diagnostics
// ---------------------------------------------------------------------------------------------
Switch                  CZero_Wican_Online              "WiCAN online [%s]"                 <if:mdi:lan-connect>            (gCZeroDiag)        {channel="mqtt:topic:wican_czero:status"}
