// Filename: ergant.items
// ergant (NUC CT 204) — things: things/MQTT_ergant.things, rules: rules/ergant.rules, rules/ergant_car.rules
// Peak guard: notification only, openHAB sheds nothing. No item here is linked to a device;
// the C-Zero rules switch Garage_SmartPlug (items/Gosund.items).
//
// Structure (see gEnergySystem in semantic_model.items):
//   Tier 1 — dashboard: semantic points under gErgant (persistence: everyChange via gEnergySystem)
//   Tier 2 — diagnostics: non-semantic gErgantDiag (persistence: everyMinute via gEnergyDiag)

// ---------------------------------------------------------------------------------------------
// Groups
// ---------------------------------------------------------------------------------------------
Group                   gErgant                         "Spitzenwächter"                    <if:mdi:shield-half-full>       (gEnergySystem)     ["Equipment"]
Group                   gErgantDiag                     "ergant Diagnose"                   <if:mdi:lan-connect>            (gEnergyDiag)


// ---------------------------------------------------------------------------------------------
// Tier 1 — dashboard
// ---------------------------------------------------------------------------------------------
Number                  Ergant_ShedLevel                "Abwurf-Stufe [%d]"                 <if:mdi:transmission-tower-off> (gErgant)           ["Status"]                  {channel="mqtt:topic:mqtt_ergant:shed_level", stateDescription=""[options="0=Kein Abwurf"]}
String                  Ergant_GuardState               "Wächter [%s]"                      <if:mdi:shield-check>           (gErgant)           ["Status"]                  {channel="mqtt:topic:mqtt_ergant:guard_state", stateDescription=""[options="ok=OK,shedding=Abwurf aktiv,alarm=Grenze überschritten,no_data=Keine Zählerdaten"]}
Number:Power            Ergant_GridLimit                "Netzbudget [%.2f kW]"              <if:mdi:speedometer>            (gErgant)           ["Setpoint","Power"]        {unit="kW", channel="mqtt:topic:mqtt_ergant:grid_limit"}
Number:Power            Ergant_PeakMonth                "Monatsspitze [%.2f kW]"            <if:mdi:chart-bell-curve>       (gErgant)           ["Measurement","Power"]     {unit="kW", channel="mqtt:topic:mqtt_ergant:peak_month"}


// ---------------------------------------------------------------------------------------------
// Tier 2 — diagnostics
// ---------------------------------------------------------------------------------------------
String                  Ergant_ShedDevices              "Abwurf-Geräte [%s]"                <if:mdi:power-plug-off>         (gErgantDiag)       {channel="mqtt:topic:mqtt_ergant:shed_devices"}
String                  Ergant_ShedBlocked              "Zurückgehalten [%s]"               <if:mdi:lock-clock>             (gErgantDiag)       {channel="mqtt:topic:mqtt_ergant:shed_blocked"}
String                  Ergant_Status                   "ergant [%s]"                       <if:mdi:lan-connect>            (gErgantDiag)       {channel="mqtt:topic:mqtt_ergant:status", stateDescription=""[options="online=Online,offline=Offline"]}


// ---------------------------------------------------------------------------------------------
// C-Zero charging (rules/ergant_car.rules switches Garage_SmartPlug, items/Gosund.items)
// Display items are virtual: the rule fills them from ergant/car/state (JSON null → UNDEF).
// Not in the energy groups on purpose: Ergant_CarSocAskedSince and Ergant_CarQuestionTs must be persisted on every change
// (default * strategy, restoreOnStartup) or a restart could ask the same session twice.
// ---------------------------------------------------------------------------------------------
Group                   gErgantCar                      "E-Auto Laden"                      <if:mdi:car-electric>           (gGarage)           ["Equipment"]
Group                   gErgantCarDiag                  "ergant Auto Diagnose"              <if:mdi:car-electric>

String                  Ergant_CarState                 "Ladezustand [%s]"                  <if:mdi:ev-station>             (gErgantCar)        ["Status"]                  {stateDescription=""[options="idle=Nicht angesteckt,charging=Lädt,paused=Pausiert,full=Voll,ended=Beendet"]}
String                  Ergant_CarReason                "Grund [%s]"                        <if:mdi:information-outline>    (gErgantCar)        ["Status"]
Number                  Ergant_CarSocHint               "Ladestand (geschätzt) [%d %%]"     <if:mdi:battery-medium>         (gErgantCar)        ["Measurement","Level"]
String                  Ergant_CarDeadlineGuard         "Abfahrtsschutz [%s]"               <if:mdi:clock-alert-outline>    (gErgantCar)        ["Status"]
// Surplus-only override: a command publishes surplus/auto (rule F), rule C mirrors ergant's state with postUpdate
Switch                  Ergant_CarSurplusSwitch         "Nur Überschuss laden"              <if:mdi:solar-power-variant>    (gErgantCar)        ["Control"]

String                  Ergant_CarCharge                "Laden Soll [%s]"                   <if:mdi:power-plug>             (gErgantCarDiag)    {channel="mqtt:topic:mqtt_ergant:car_charge", stateDescription=""[options="on=Ein,off=Aus"]}
String                  Ergant_CarStateJson             "Ladezustand JSON [%s]"             <if:mdi:code-json>              (gErgantCarDiag)    {channel="mqtt:topic:mqtt_ergant:car_state"}
String                  Ergant_CarPlan                  "Ladeplan JSON [%s]"                <if:mdi:code-json>              (gErgantCarDiag)    {channel="mqtt:topic:mqtt_ergant:car_plan"}
String                  Ergant_CarSocAskedSince         "Ladestand gefragt für [%s]"        <if:mdi:help-circle-outline>    (gErgantCarDiag)
// ergant/car/question (retained JSON ts/kind/text/expected_soc/departure; empty = no open question).
// Ergant_CarQuestionTs: persisted on every change + restoreOnStartup (mapdb * line) — rule D dedupes
// against it and rule E accepts an override answer only for this ts.
String                  Ergant_CarQuestion              "Frage JSON [%s]"                   <if:mdi:code-json>              (gErgantCarDiag)    {channel="mqtt:topic:mqtt_ergant:car_question"}
String                  Ergant_CarQuestionTs            "Frage gestellt (ts) [%s]"          <if:mdi:help-circle-outline>    (gErgantCarDiag)


// ---------------------------------------------------------------------------------------------
// PV heating (rules/ergant_heat.rules switches Split_Wohnzimmer_* and Split_BueroHerwig_*,
// items/Samsung_Split.items). Item names carry the ergant room: Ergant_Heat<Room>_* with
// <Room> = Wohnzimmer → ergant/heat/wohnzimmer, Buero → ergant/heat/buero (the rules derive it).
// Not in the energy groups on purpose (same as gErgantCarDiag): the *_AskedTs items must be
// persisted on every change with restoreOnStartup, or a restart could ask the same offer twice.
// gErgantHeatCmd is excluded from restoreOnStartup (mapdb, influxdb): a restored "off" followed
// by the retained "on" would look like an off → on change at startup.
// ---------------------------------------------------------------------------------------------
Group                   gErgantHeatDiag                 "ergant Heizen Diagnose"            <if:mdi:radiator>
Group                   gErgantHeatCmd                  "ergant Heizen Soll (Regel-Trigger)" <if:mdi:radiator>
Group                   gErgantHeatOffer                "ergant Heizen Angebote (Regel-Trigger)" <if:mdi:radiator>

String                  Ergant_HeatWohnzimmer_Cmd       "Heizen Wohnzimmer Soll [%s]"       <if:mdi:radiator>               (gErgantHeatDiag, gErgantHeatCmd)       {channel="mqtt:topic:mqtt_ergant:heat_wohnzimmer", stateDescription=""[options="on=Ein,off=Aus"]}
String                  Ergant_HeatWohnzimmer_Offer     "Heizen Wohnzimmer Angebot [%s]"    <if:mdi:code-json>              (gErgantHeatDiag, gErgantHeatOffer)     {channel="mqtt:topic:mqtt_ergant:heat_wohnzimmer_offer"}
String                  Ergant_HeatWohnzimmer_StateJson "Heizen Wohnzimmer Zustand [%s]"    <if:mdi:code-json>              (gErgantHeatDiag)                       {channel="mqtt:topic:mqtt_ergant:heat_wohnzimmer_state"}
String                  Ergant_HeatWohnzimmer_AskedTs   "Heizen Wohnzimmer gefragt für [%s]" <if:mdi:help-circle-outline>   (gErgantHeatDiag)

String                  Ergant_HeatBuero_Cmd            "Heizen Büro Soll [%s]"             <if:mdi:radiator>               (gErgantHeatDiag, gErgantHeatCmd)       {channel="mqtt:topic:mqtt_ergant:heat_buero", stateDescription=""[options="on=Ein,off=Aus"]}
String                  Ergant_HeatBuero_Offer          "Heizen Büro Angebot [%s]"          <if:mdi:code-json>              (gErgantHeatDiag, gErgantHeatOffer)     {channel="mqtt:topic:mqtt_ergant:heat_buero_offer"}
String                  Ergant_HeatBuero_StateJson      "Heizen Büro Zustand [%s]"          <if:mdi:code-json>              (gErgantHeatDiag)                       {channel="mqtt:topic:mqtt_ergant:heat_buero_state"}
String                  Ergant_HeatBuero_AskedTs        "Heizen Büro gefragt für [%s]"      <if:mdi:help-circle-outline>    (gErgantHeatDiag)

// Room temperatures → ergant/input/room_temp/<ItemName> (rules/ergant_heat.rules). Membership is set
// on the sensor items (items/BLE_Sensors.items, items/knx.items); adding a room = adding this group.
// Not the Split_*_Temperature items: they measure at the indoor unit.
Group                   gErgantRoomTemp                 "ergant Raumtemperaturen"           <if:mdi:home-thermometer>
