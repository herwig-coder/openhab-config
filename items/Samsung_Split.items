String                  Split_Wintergarten_FanMode         "Lüfterstufe [%s]"                  <if:mdi:fan>                    (gSplitWintergarten) ["Control","Airflow"]       {channel="mqtt:topic:samsung_wintergarten:fan_mode", stateDescription=""[options="auto=Auto,low=Niedrig,medium=Mittel,high=Hoch,Turbo=Turbo"], commandDescription=""[options="auto=Auto,low=Niedrig,medium=Mittel,high=Hoch,Turbo=Turbo"]}
String                  Split_Wintergarten_Swing           "Swing [%s]"                        <if:mdi:arrow-oscillating>      (gSplitWintergarten) ["Control"]                 {channel="mqtt:topic:samsung_wintergarten:swing", stateDescription=""[options="off=Aus,vertical=Vertikal,horizontal=Horizontal,both=Beides"], commandDescription=""[options="off=Aus,vertical=Vertikal,horizontal=Horizontal,both=Beides"]}
String                  Split_Wintergarten_Preset          "Preset [%s]"                       <if:mdi:weather-windy>          (gSplitWintergarten) ["Control","Mode"]          {channel="mqtt:topic:samsung_wintergarten:preset", stateDescription=""[options="none=Kein,WindFree=WindFree"], commandDescription=""[options="none=Kein,WindFree=WindFree (nur Kühlen/Entfeuchten/Lüften)"]}
Number:Temperature      Split_Wintergarten_Temperature     "Raumtemperatur (Klima) [%.1f °C]"  <if:mdi:thermometer>            (gSplitWintergarten) ["Measurement","Temperature"] {unit="°C", channel="mqtt:topic:samsung_wintergarten:temperature"}
Number:Dimensionless    Split_Wintergarten_Humidity        "Luftfeuchte (Klima) [%.0f %%]"     <if:mdi:water-percent>          (gSplitWintergarten) ["Measurement","Humidity"]  {unit="%", channel="mqtt:topic:samsung_wintergarten:humidity"}


// ---------------------------------------------------------------------------------------------
// Outdoor unit ODU 1 (Garten hinten) — AJ040TXJ2KG
// ---------------------------------------------------------------------------------------------
Number                  Split_Odu1_ErrorCode            "Fehlercode [%d]"                   <if:mdi:alert-circle-outline>   (gSplitOdu1, gSamsungErrorCode)         ["Alarm"]                   {channel="mqtt:topic:samsung_odu1:error_code", stateDescription=""[options="0=OK"]}
Number:Temperature      Split_Odu1_OutdoorTemp          "Außentemperatur (Klima) [%.1f °C]" <if:mdi:thermometer>            (gSplitOdu1)                            ["Measurement","Temperature"] {unit="°C", channel="mqtt:topic:samsung_odu1:outdoor_temp"}
Number:Power            Split_Odu1_Power                "Leistung [%.0f W]"                 <if:mdi:flash>                  (gSplitOdu1, gSamsungEnergyDiag)        ["Measurement","Power"]     {unit="W", channel="mqtt:topic:samsung_odu1:power"}
Number:Energy           Split_Odu1_Energy               "Energie [%.2f kWh]"                <if:mdi:counter>                (gSplitOdu1, gSamsungEnergyDiag)        ["Measurement","Energy"]    {unit="kWh", channel="mqtt:topic:samsung_odu1:energy"}
Number:ElectricCurrent  Split_Odu1_Current              "Strom [%.1f A]"                    <if:mdi:current-ac>             (gSamsungEnergyDiag)                                                {unit="A", channel="mqtt:topic:samsung_odu1:current"}


// ---------------------------------------------------------------------------------------------
// ESP bridge diagnostics ODU 1 (non-semantic)
// ---------------------------------------------------------------------------------------------
Switch                  Split_Odu1_Esp_Online           "ESP ODU1 online [%s]"                   <if:mdi:lan-connect>            (gSamsungDiag)                                                      {channel="mqtt:topic:samsung_odu1:esp_online"}
Number:Time             Split_Odu1_Esp_Uptime           "ESP ODU1 Uptime [%.0f s]"               <if:mdi:timer-outline>          (gSamsungDiag)                                                      {unit="s", channel="mqtt:topic:samsung_odu1:esp_uptime"}
Number                  Split_Odu1_Esp_Wifi             "ESP ODU1 WLAN-Signal [%.0f dBm]"        <if:mdi:wifi>                   (gSamsungDiag)                                                      {channel="mqtt:topic:samsung_odu1:esp_wifi"}
String                  Split_Odu1_Esp_ResetReason      "ESP ODU1 Reset-Grund [%s]"              <if:mdi:restart>                (gSamsungDiag)                                                      {channel="mqtt:topic:samsung_odu1:esp_reset"}
