// ergant energy optimizer (NUC CT 204, 10.1.0.204) — notifications and peak guard on the main broker.
//
// ergant publishes JSON {"level","title","message","ts"} on ergant/notify (not retained) and
// drives the Ulanzi itself; openHAB only relays to Telegram (rules/ergant.rules).
// Peak guard topics are retained and read-only here: openHAB only notifies, it sheds nothing
// (capacity tariff not billed yet). Items: items/ergant.items.
// C-Zero charging: ergant decides (ergant/car/*), rules/ergant_car.rules switches Garage_SmartPlug.
// PV heating: ergant decides (ergant/heat/*), rules/ergant_heat.rules switches the Wohnzimmer and Büro splits.
// The inputs ergant/car/soc_hint and ergant/car/override are published by the rules via the MQTT
// action (one-shot, never retained) — no command channels for them.
// No availabilityTopic on purpose: ergant/status is a normal channel so the offline rules can
// time it; the thing stays ONLINE while ergant is down.
// Same UI-managed broker bridge as Ulanzi and Matrix; no credentials here.
Thing mqtt:topic:mqtt_ergant "MQTT ergant" (mqtt:broker:9a73e5895e) {
    Channels:
    Type trigger       : notify                "Meldung"            [ stateTopic="ergant/notify"]
    Type number        : shed_level            "Abwurf-Stufe"       [ stateTopic="ergant/shed_level"]
    Type string        : shed_devices          "Abwurf-Geräte"      [ stateTopic="ergant/shed_devices"]
    Type string        : shed_blocked          "Zurückgehalten"     [ stateTopic="ergant/shed_blocked"]
    Type string        : guard_state           "Wächter-Status"     [ stateTopic="ergant/guard/state"]
    Type number        : grid_limit            "Netzbudget"         [ stateTopic="ergant/grid_limit_kw", unit="kW"]
    Type number        : peak_month            "Monatsspitze"       [ stateTopic="ergant/peak/month_kw", unit="kW"]
    Type string        : status                "Verbindung"         [ stateTopic="ergant/status"]
    Type string        : car_charge            "Auto laden (Soll)"  [ stateTopic="ergant/car/charge"]
    Type string        : car_state             "Auto Ladezustand"   [ stateTopic="ergant/car/state"]
    Type string        : car_plan              "Auto Ladeplan"      [ stateTopic="ergant/car/plan"]
    // PV heating (rules/ergant_heat.rules). <room> = ergant room name: wohnzimmer (ODU 1), buero (ODU 2).
    // ergant/heat/<room>/answer and ergant/input/room_temp/* are published by the rules via the MQTT action.
    Type string        : heat_wohnzimmer       "Heizen Wohnzimmer (Soll)"   [ stateTopic="ergant/heat/wohnzimmer"]
    Type string        : heat_wohnzimmer_offer "Heizen Wohnzimmer Angebot"  [ stateTopic="ergant/heat/wohnzimmer/offer"]
    Type string        : heat_wohnzimmer_state "Heizen Wohnzimmer Zustand"  [ stateTopic="ergant/heat/wohnzimmer/state"]
    Type trigger       : heat_wohnzimmer_event "Heizen Wohnzimmer Ereignis" [ stateTopic="ergant/heat/wohnzimmer/event"]
    Type string        : heat_buero            "Heizen Büro (Soll)"         [ stateTopic="ergant/heat/buero"]
    Type string        : heat_buero_offer      "Heizen Büro Angebot"        [ stateTopic="ergant/heat/buero/offer"]
    Type string        : heat_buero_state      "Heizen Büro Zustand"        [ stateTopic="ergant/heat/buero/state"]
    Type trigger       : heat_buero_event      "Heizen Büro Ereignis"       [ stateTopic="ergant/heat/buero/event"]
}
