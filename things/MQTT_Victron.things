// ---------------------------------------------------------------------------------------------
// ESS settings (com.victronenergy.settings/0, Settings/CGwacs)
// ---------------------------------------------------------------------------------------------
// hub4_mode:          1=optimized with phase compensation, 2=optimized without phase compensation, 3=external control
// max_*_power:        -1 = no limit
Thing mqtt:topic:victron_ess "Victron ESS" (mqtt:broker:victron) @ "Hobbyraum" {
    Channels:
    Type number : grid_setpoint            "ESS Grid Setpoint"            [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/AcPowerSetPoint", transformationPattern="JSONPATH:$.value", unit="W" ]
    Type number : min_soc                  "ESS Minimum SOC"              [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/BatteryLife/MinimumSocLimit", transformationPattern="JSONPATH:$.value", unit="%" ]
    Type number : active_soc_limit         "ESS Active SOC Limit"         [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/BatteryLife/SocLimit", transformationPattern="JSONPATH:$.value", unit="%" ]
    Type number : batterylife_state        "ESS BatteryLife State"        [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/BatteryLife/State", transformationPattern="JSONPATH:$.value" ]
    Type number : hub4_mode                "ESS Mode"                     [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/Hub4Mode", transformationPattern="JSONPATH:$.value" ]
    Type number : max_charge_power         "ESS Max Charge Power"         [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/MaxChargePower", transformationPattern="JSONPATH:$.value", unit="W" ]
    Type number : max_discharge_power      "ESS Max Discharge Power"      [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/MaxDischargePower", transformationPattern="JSONPATH:$.value", unit="W" ]
    Type number : max_feed_in_power        "ESS Max Feed-in Power"        [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/MaxFeedInPower", transformationPattern="JSONPATH:$.value", unit="W" ]

    // --- Control (disabled) ---
    // Type number : grid_setpoint_control "ESS Grid Setpoint Control"    [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/AcPowerSetPoint", commandTopic="W/c0619ab6f9ea/settings/0/Settings/CGwacs/AcPowerSetPoint", transformationPattern="JSONPATH:$.value", formatBeforePublish="{\"value\": %s}", unit="W" ]
    // Type number : min_soc_control       "ESS Minimum SOC Control"      [ stateTopic="N/c0619ab6f9ea/settings/0/Settings/CGwacs/BatteryLife/MinimumSocLimit", commandTopic="W/c0619ab6f9ea/settings/0/Settings/CGwacs/BatteryLife/MinimumSocLimit", transformationPattern="JSONPATH:$.value", formatBeforePublish="{\"value\": %s}", unit="%", min="10", max="100", step="5" ]
}
