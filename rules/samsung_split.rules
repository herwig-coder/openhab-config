// Samsung FJM split AC (NASA bus via ESPHome) — items: items/Samsung_Split.items, behaviour/checklist: docs/samsung-split.md
//
// Error code of an outdoor unit → Telegram home alerts bot. One rule for all outdoor units via gSamsungErrorCode:
//   Split_Odu2_ErrorCode — ODU 2 (carport): Büro Herwig + Hobbyraum
//   Split_Odu1_ErrorCode — ODU 1 (Garten hinten): Wohnzimmer + Wintergarten
// ESP offline/online is monitored by Uptime Kuma (MQTT monitors on samsung-odu*/status), not here.

// ─── Error code alarm ──────────────────────────────────────────────────────
rule "Samsung Fehlercode Aussengeraet"
when
    Member of gSamsungErrorCode changed
then
    if (triggeringItem.state == NULL || triggeringItem.state == UNDEF) return;
    // First value after openHAB/ESP start is not a change worth reporting
    if (previousState == NULL || previousState == UNDEF) {
        logInfo("samsung_split", "{} initialised: {}", triggeringItem.name, triggeringItem.state.toString)
        return;
    }

    val int code = (triggeringItem.state as DecimalType).intValue
    val int prev = (previousState as DecimalType).intValue
    val String unit = if (triggeringItem.name.startsWith("Split_Odu1_")) "ODU 1 (Wohnzimmer / Wintergarten)" else "ODU 2 (Büro Herwig / Hobbyraum)"
    val telegramAction = getActions("telegram", "telegram:telegramBot:Telegram_Bot")

    if (code != 0) {
        logWarn("samsung_split", "{} error code {} (previously {})", triggeringItem.name, code, prev)
        telegramAction.sendTelegram("⚠️ Klimaanlage " + unit + ": Fehlercode " + code + ". Code am Display/in der Samsung-Fehlerliste nachsehen.")
    } else {
        logInfo("samsung_split", "{} error code cleared (was {})", triggeringItem.name, prev)
        telegramAction.sendTelegram("✅ Klimaanlage " + unit + ": Fehlercode " + prev + " behoben.")
    }
end


// ─── Auto-Reinigung nach Ausschalten durch openHAB ─────────────────────────
// The IR remote can trigger coil drying when switching off (10-30 min, display 1-99 %); the unit
// decides by condition (after short heating it may skip). A NASA "off" from openHAB never does.
// Tests 2026-10-24:
//   - off via openHAB, THEN AutoClean ON  -> drying starts (Büro)                       ✔
//   - AutoClean ON while running, then off -> beep, no effect, unit just off (Wohnzimmer) ✘
// So: openHAB "off" for a RUNNING unit marks it; as soon as the unit itself reports "off",
// AutoClean ON is sent (event-driven, no fixed delay). The mark expires after 30 s, so an off
// from the remote or an ESP reboot (boot default "off") never triggers a cleaning.
// Mode items have autoupdate="false": at command time triggeringItem.state is still the previous
// mode, and the later "changed to off" really comes from the unit.
val java.util.Map<String, Long> autoCleanPending = newHashMap

rule "Samsung Auto-Reinigung: openHAB-Aus vormerken"
when
    Member of gSamsungSplitMode received command
then
    if (receivedCommand.toString != "off") return;
    val String prev = triggeringItem.state.toString
    if (prev == "off" || prev == "NULL" || prev == "UNDEF") {
        logInfo("samsung_split", "{}: off command while already {}, no auto-clean", triggeringItem.name, prev)
        return;
    }
    autoCleanPending.put(triggeringItem.name, now.toInstant.toEpochMilli)
    logInfo("samsung_split", "{}: off by openHAB (was {}), auto-clean once the unit confirms off", triggeringItem.name, prev)
end

rule "Samsung Auto-Reinigung: nach bestätigtem Aus starten"
when
    Member of gSamsungSplitMode changed to "off"
then
    val Long marked = autoCleanPending.remove(triggeringItem.name)
    if (marked === null) return;                                  // not switched off by openHAB
    if (now.toInstant.toEpochMilli - marked > 30000) {
        logInfo("samsung_split", "{}: off confirmation too late, no auto-clean", triggeringItem.name)
        return;
    }
    val String acName = triggeringItem.name.replace("_Mode", "_AutoClean")
    val String espOnline = if (acName.startsWith("Split_Wohnzimmer_") || acName.startsWith("Split_Wintergarten_")) "Split_Odu1_Esp_Online" else "Split_Odu2_Esp_Online"
    val esp = org.openhab.core.model.script.ScriptServiceUtil.getItemRegistry.getItem(espOnline)
    if (esp.state != ON) {
        logWarn("samsung_split", "{}: ESP offline, auto-clean not sent", acName)
        return;
    }
    logInfo("samsung_split", "{}: unit confirmed off, starting auto-clean", acName)
    sendCommand(acName, "ON")
end
