// Samsung FJM split AC (NASA bus via ESPHome) — items: items/Samsung_Split.items, behaviour/checklist: docs/samsung-split.md
//
// Error code of an outdoor unit → Telegram home alerts bot. One rule for all outdoor units via gSamsungErrorCode:
//   Split_Odu2_ErrorCode — ODU 2 (carport): Büro Herwig + Hobbyraum
//   Split_Odu1_ErrorCode — ODU 1 (Garten hinten): Wohnzimmer + Wintergarten
// ESP offline/online is monitored by Uptime Kuma (MQTT monitors on samsung-odu*/status), not here.

// ─── Error code alarm ──────────────────────────────────────────────────────
rule "Samsung Fehlercode Aussengeraet"
when
    Member of gSamsungErrorCode changed
then
    if (triggeringItem.state == NULL || triggeringItem.state == UNDEF) return;
    // First value after openHAB/ESP start is not a change worth reporting
    if (previousState == NULL || previousState == UNDEF) {
        logInfo("samsung_split", "{} initialised: {}", triggeringItem.name, triggeringItem.state.toString)
        return;
    }

    val int code = (triggeringItem.state as DecimalType).intValue
    val int prev = (previousState as DecimalType).intValue
    val String unit = if (triggeringItem.name.startsWith("Split_Odu1_")) "ODU 1 (Wohnzimmer / Wintergarten)" else "ODU 2 (Büro Herwig / Hobbyraum)"
    val telegramAction = getActions("telegram", "telegram:telegramBot:Telegram_Bot")

    if (code != 0) {
        logWarn("samsung_split", "{} error code {} (previously {})", triggeringItem.name, code, prev)
        telegramAction.sendTelegram("⚠️ Klimaanlage " + unit + ": Fehlercode " + code + ". Code am Display/in der Samsung-Fehlerliste nachsehen.")
    } else {
        logInfo("samsung_split", "{} error code cleared (was {})", triggeringItem.name, prev)
        telegramAction.sendTelegram("✅ Klimaanlage " + unit + ": Fehlercode " + prev + " behoben.")
    }
end
