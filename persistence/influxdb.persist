// InfluxDB — long-term history (Grafana)
// Migrated from the UI/JSONDB config on 2026-09-12 (was: * → everyChange, restoreOnStartup).
// Energy items change every second → throttled instead of persisted on every change.
// Note: config lines are additive, so the energy groups must be excluded from the * line.

Strategies {
    everyMinute : "0 * * * * ?"
}

Filters {
    atMostEvery10s : T 10 s
}

Items {
    // Everything except energy: unchanged
    *, !gEnergySystem*, !gEnergyDiag* : strategy = everyChange, restoreOnStartup

    // Energy dashboard: on change, max. one value per 10 s per item. The time filter drops
    // values but never writes them later — everyMinute bounds a stale last value to ~1 min.
    gEnergySystem*, !gEnergyDiag* : strategy = everyChange, everyMinute, restoreOnStartup filter = atMostEvery10s

    // Energy diagnostics: one sample per minute is plenty for Grafana
    gEnergyDiag* : strategy = everyMinute, restoreOnStartup
}
